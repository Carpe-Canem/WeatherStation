<title>Holiday Outfits</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&family=Pixelify+Sans:wght@500;700&display=swap">
<style>
/* Layout: the weather app's own pixel-sky look. A sky page with frosted cards; each card is one option,
   and its tiles are windows onto the sky where the dog performs one pose. Picks collect in a bar at the bottom. */
:root {
  --page: #9ed3f0; --surface: rgba(255, 255, 255, 0.72); --solid: #f3f8fb;
  --ink: #10243a; --ink2: #34506b; --muted: #4f6a86; --line: rgba(16, 36, 58, 0.16); --border: rgba(255, 255, 255, 0.8);
  --accent: #c2540f; --on-accent: #ffffff; --ring: rgba(194, 84, 15, 0.35);
  --sky-day: #9ed3f0; --gnd-day: #f3f8fb; --sky-night: #101a33; --gnd-night: #1d2a4d;
  --sans: "Manrope", system-ui, -apple-system, "Segoe UI", sans-serif;
  --pixel: "Pixelify Sans", "Manrope", system-ui, sans-serif;
  --r: 16px;
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --page: #101a33; --surface: rgba(24, 36, 70, 0.78); --solid: #17223f;
    --ink: #eef3ff; --ink2: #b9c6e0; --muted: #94a5c6; --line: rgba(255, 255, 255, 0.16); --border: rgba(255, 255, 255, 0.14);
    --accent: #ffb347; --on-accent: #1a1205; --ring: rgba(255, 179, 71, 0.4);
    color-scheme: dark;
  }
}
:root[data-theme="dark"] {
  --page: #101a33; --surface: rgba(24, 36, 70, 0.78); --solid: #17223f;
  --ink: #eef3ff; --ink2: #b9c6e0; --muted: #94a5c6; --line: rgba(255, 255, 255, 0.16); --border: rgba(255, 255, 255, 0.14);
  --accent: #ffb347; --on-accent: #1a1205; --ring: rgba(255, 179, 71, 0.4);
  color-scheme: dark;
}
* { box-sizing: border-box; }
body { background: var(--page); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.5; }
.wrap { max-width: 1180px; margin: 0 auto; padding-block: 28px 150px; padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); display: flex; flex-direction: column; gap: 28px; }
h1, h2, h3, p { margin: 0; }
h1 { font-family: var(--pixel); font-weight: 700; font-size: clamp(30px, 6vw, 46px); line-height: 1.05; letter-spacing: 0.01em; text-wrap: balance; }
.eyebrow { font-size: 12px; font-weight: 800; letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink2); }
.lede { max-width: 62ch; color: var(--ink2); font-size: 16px; }
header { display: flex; flex-direction: column; gap: 10px; }
canvas { image-rendering: pixelated; display: block; }

.sky { background: var(--sky-day); --gnd: var(--gnd-day); --tag: #10243a; }
[data-sky="night"] .sky { background: var(--sky-night); --gnd: var(--gnd-night); --tag: #eef3ff; }

.yard { position: relative; height: 150px; border-radius: var(--r); overflow: hidden; border: 1px solid var(--border); }
.yard::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 16px; background: var(--gnd); }
.yard canvas { position: absolute; left: 0; top: 0; z-index: 1; will-change: transform; }
.yard .tag { position: absolute; left: 12px; top: 10px; font-size: 12px; font-weight: 700; color: var(--tag); opacity: 0.8; }

.controls { display: flex; flex-wrap: wrap; gap: 10px 18px; align-items: center; }
.seg { display: inline-flex; background: var(--surface); border: 1px solid var(--border); border-radius: 999px; padding: 3px; }
.seg button, .btn { font: inherit; font-weight: 700; font-size: 13px; color: var(--ink2); background: none; border: 0; border-radius: 999px; padding: 7px 14px; cursor: pointer; }
.seg button[aria-pressed="true"] { background: var(--solid); color: var(--ink); box-shadow: 0 1px 4px rgba(16, 36, 58, 0.18); }
.controls label { font-size: 12px; font-weight: 800; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink2); display: inline-flex; align-items: center; gap: 8px; }
button:focus-visible, textarea:focus-visible { outline: 3px solid var(--ring); outline-offset: 2px; }

.dog { display: flex; flex-direction: column; gap: 14px; }
.dog-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 14px; border-bottom: 2px solid var(--line); padding-bottom: 8px; }
.dog-head h2 { font-weight: 800; font-size: 26px; line-height: 1.1; letter-spacing: -0.01em; }
.dog-head p { color: var(--ink2); font-size: 14px; }

.opt { background: var(--surface); border: 1px solid var(--border); border-radius: var(--r); padding: 16px; display: flex; flex-direction: column; gap: 14px; box-shadow: 0 2px 10px rgba(16, 36, 58, 0.08); }
.opt.picked { outline: 3px solid var(--accent); outline-offset: -1px; }
.opt-head { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 14px; }
.letter { font-weight: 800; font-size: 19px; width: 38px; height: 38px; display: grid; place-items: center; border-radius: 10px; background: var(--solid); color: var(--ink); flex: none; }
.picked .letter { background: var(--accent); color: var(--on-accent); }
.opt-text { flex: 1 1 220px; min-width: 0; }
.opt-text h3 { font-size: 17px; font-weight: 800; line-height: 1.25; }
.opt-text p { color: var(--ink2); font-size: 14px; }
.swatches { display: flex; gap: 8px; align-items: flex-end; padding: 8px; border-radius: 10px; }
.pick { font: inherit; font-weight: 800; font-size: 14px; padding: 9px 18px; border-radius: 999px; border: 2px solid var(--accent); background: transparent; color: var(--accent); cursor: pointer; flex: none; }
.picked .pick { background: var(--accent); color: var(--on-accent); }

.tiles { display: flex; flex-wrap: wrap; gap: 12px; }
.tile { display: flex; flex-direction: column; gap: 5px; min-width: 0; }
.tile .win { position: relative; overflow: hidden; border-radius: 10px; max-width: 100%; }
.tile .win::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: var(--gh, 0px); background: var(--gnd); }
.tile .win.air::after { display: none; }
.tile canvas { position: relative; z-index: 1; }
.tile span { font-size: 12px; font-weight: 700; color: var(--ink2); }

.none { align-self: flex-start; font: inherit; font-size: 13px; font-weight: 700; color: var(--ink2); background: none; border: 1px dashed var(--line); border-radius: 999px; padding: 7px 14px; cursor: pointer; }
.none[aria-pressed="true"] { border-style: solid; border-color: var(--accent); color: var(--accent); }

.notes { display: flex; flex-direction: column; gap: 8px; }
.notes label { font-weight: 800; }
.notes textarea { font: inherit; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 12px; padding: 12px; min-height: 84px; width: 100%; max-width: 720px; resize: vertical; }

.bar { position: fixed; left: 0; right: 0; bottom: 0; z-index: 20; background: var(--solid); border-top: 1px solid var(--line); box-shadow: 0 -6px 20px rgba(16, 36, 58, 0.16);
  padding-top: 10px; padding-bottom: calc(10px + env(safe-area-inset-bottom, 0px)); padding-left: max(16px, env(safe-area-inset-left, 0px)); padding-right: max(16px, env(safe-area-inset-right, 0px)); }
.bar-in { max-width: 1180px; margin: 0 auto; display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
.chips { display: flex; flex-wrap: wrap; gap: 6px 8px; flex: 1 1 260px; min-width: 0; }
.chip { font-size: 13px; font-weight: 700; padding: 5px 11px; border-radius: 999px; border: 1px solid var(--line); color: var(--ink2); }
.chip.set { border-color: var(--accent); color: var(--ink); }
.copy { font: inherit; font-weight: 800; font-size: 14px; padding: 10px 18px; border-radius: 999px; border: 0; background: var(--accent); color: var(--on-accent); cursor: pointer; }
#picks-text { flex: 1 1 100%; font: inherit; font-size: 13px; color: var(--ink); background: var(--surface); border: 1px solid var(--line); border-radius: 10px; padding: 8px; min-height: 56px; }
